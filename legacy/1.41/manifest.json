{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.41",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "JellyKingStudio",
  "permissions": [
    "activeTab",
    "browsingData",
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "system.display"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "incognito": "spanning"
}
